<?xml version="1.0" encoding="utf-8"?>
<!--
  Put this file inside the "uploads" folder of the project (next to "products").
  It makes IIS serve everything in this folder as plain static files and never run it
  as a script, so even a malicious upload can't be executed.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
